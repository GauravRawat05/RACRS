# ==============================================================================
# AI-Powered Resume Analysis & Career Recommendation System
# Environment Variables Configuration
# ==============================================================================

# Option 1: OpenRouter (Primary inference gateway using free models)
# Get a free key at: https://openrouter.ai/settings/keys
# Uses openrouter/free, google/gemma-4-31b:free, nvidia/nemotron-3-ultra:free
OPENROUTER_API_KEY=

# Option 2: Groq (High-speed backup failover)
# Get a key at: https://console.groq.com/keys
# Uses GPT OSS 120B, GPT OSS 20B, Qwen 3.8 27B
GROQ_API_KEY=

# Optional: Site URL for OpenRouter ranking headers
NEXT_PUBLIC_SITE_URL=http://localhost:3000
